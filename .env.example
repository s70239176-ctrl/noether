# Copy to .env and fill in. Never commit .env.

# One funded testnet key: needs Base Sepolia ETH, Unichain Sepolia ETH and Lasna REACT.
# Lasna REACT: send Sepolia ETH to the Reactive faucet 0x9b9BB25f1A81078C544C829c5EB7822d747Cf434
# on Ethereum Sepolia (100 REACT per 1 SepETH, max 5 SepETH per tx), per the Reactive docs.
PRIVATE_KEY=

LASNA_RPC=https://lasna-rpc.rnk.dev/
BASE_SEPOLIA_RPC=https://sepolia.base.org
UNICHAIN_SEPOLIA_RPC=https://unichain-sepolia-rpc.publicnode.com
# Ethereum Sepolia: only used to buy REACT from the faucet.
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Optional knobs (defaults shown)
# RELAYER=<deployer>                     # the route's trusted relayer (Hyperlane TrustedRelayerIsm)
# DEST_GAS_FUNDING=20000000000000000      # 0.02 ETH per destination contract, pays callback fees
# LEDGER_FUNDING=2000000000000000000      # 2 REACT for the ledger's reactive transactions
# GRACE_BLOCKS=5                          # Lasna blocks (~1 s each) a suspect may stay unexplained
# COVER_CAPITAL=10000000000000000         # 0.01 ETH of underwriting capital
# COVER_POLICIES=3
